# URL do PostgreSQL do Supabase (Dashboard do projeto > Connect).
# Copie este arquivo para .env e substitua pelos dados reais.
# Não versione credenciais reais.
# Autenticacao propria do painel (este projeto nao usa NextAuth).
ADMIN_USER=
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:PORTA/BANCO?sslmode=require"
ADMIN_PASS=
JWT_SECRET=

# URL pública do Supabase para leitores do site e chave privilegiada usada somente
# pelo servidor para enviar imagens ao bucket já provisionado.
SUPABASE_URL=
SUPABASE_STORAGE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=site-publico
SUPABASE_STORAGE_MAX_FILE_SIZE_BYTES=6291456
SUPABASE_STORAGE_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp
# Ative somente depois de confirmar o schema e a carga no banco deste ambiente.
CONTEUDO_EDITORIAL_SUPABASE_ATIVO=false

# Opcional: origem explícita para inventário somente leitura de conteúdo.
# Sem esta variável, use --ler-banco --usar-banco-atual para escolher DATABASE_URL.
# Nunca use NEXT_PUBLIC_ para conexões de banco.
ORIGEM_DATABASE_URL=

# Importador de conteúdo: destino explicitamente separado da DATABASE_URL do app.
# Deixe desabilitado até confirmar o projeto de staging; o comando exige também --aplicar e confirmações.
STAGING_IMPORT_ENABLED=false
STAGING_PROJECT_REF=
STAGING_DATABASE_URL=
STAGING_SUPABASE_URL=
STAGING_SUPABASE_SECRET_KEY=
# Compatibilidade temporária com o JWT legado; prefira a secret API key.
STAGING_SUPABASE_SERVICE_ROLE_KEY=
STAGING_STORAGE_BUCKET=site-publico
STAGING_STORAGE_MAX_FILE_SIZE_BYTES=
STAGING_STORAGE_ALLOWED_MIME_TYPES=
STAGING_ORIGEM_DESTINO=

# Produção: deixe as travas desligadas. Valores reais somente em .env.producao.local.
# A URL do banco deve usar usuário de migração com escrita e TLS; nunca reutilize ORIGEM_DATABASE_URL.
PRODUCAO_MIGRATIONS_ENABLED=false
PRODUCAO_IMPORT_ENABLED=false
PRODUCAO_PROJECT_REF=
PRODUCAO_DATABASE_URL=
PRODUCAO_SUPABASE_URL=
PRODUCAO_SUPABASE_SECRET_KEY=
PRODUCAO_STORAGE_BUCKET=site-publico
PRODUCAO_STORAGE_MAX_FILE_SIZE_BYTES=
PRODUCAO_STORAGE_ALLOWED_MIME_TYPES=
PRODUCAO_ORIGEM_DESTINO=mesmo-banco
