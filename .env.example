# URL do PostgreSQL do Supabase (Dashboard do projeto > Connect).
# Copie este arquivo para .env e substitua pelos dados reais.
# Não versione credenciais reais.
# Autenticacao propria do painel (este projeto nao usa NextAuth).
ADMIN_USER=
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:PORTA/BANCO?sslmode=require"
ADMIN_PASS=
JWT_SECRET=
